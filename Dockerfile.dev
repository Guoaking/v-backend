# Dev Dockerfile: Assumes local build has produced kyc-service-linux
FROM alpine:3.19

# Use Aliyun mirror
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories
RUN apk add --no-cache ca-certificates tzdata

RUN addgroup -g 1000 -S appuser && \
    adduser -u 1000 -S appuser -G appuser

WORKDIR /app

# Copy binary from host
COPY kyc-service-linux ./kyc-service
# We copy all configs so they are available in the container
COPY config.*.yaml ./

RUN mkdir -p /app/logs && chown -R appuser:appuser /app

USER appuser

ENV KYC_PORT=8082
EXPOSE 8082 8092

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${KYC_PORT}/metrics || exit 1

CMD ["./kyc-service"]
